# Kenari API key (required for generation/download/video tools)
KENARI_API_KEY=kn-REPLACE_ME
# Base URL (default https://kenari.id/v1)
KENARI_BASE_URL=https://kenari.id/v1
# Directory where generated media is saved
KENARI_OUTPUT_DIR=./kenari-output
# Set to 0/false to disable video tools
KENARI_ALLOW_VIDEO=
# Max images per generate/edit call (preflight cap)
KENARI_MAX_IMAGE_N=4
# Max video duration seconds (preflight cap)
KENARI_MAX_VIDEO_DURATION=15
# Optional per-call cost ceiling in IDR (preflight; image tools only)
KENARI_MAX_COST_IDR_PER_CALL=
